# Groq API Key (required)
# Get your key at: https://console.groq.com/
GROQ_API_KEY=gsk_your_api_key_here

# Optional: Path to FFmpeg binary (auto-detected if not set)
# FFMPEG_PATH=/usr/local/bin/ffmpeg

# Silence removal settings (for reducing Whisper hallucinations)
# SILENCE_DURATION=1        # Minimum silence duration in seconds to remove
# SILENCE_THRESHOLD=-40dB   # Audio level threshold for silence detection

# Meeting settings
# ALONE_WAIT_SECONDS=15       # Seconds to wait after last participant leaves
# EMPTY_MEETING_TIMEOUT=600   # Seconds to wait if no one joins (default: 10 min)
# WAITING_ROOM_TIMEOUT=300    # Seconds to wait in waiting room (default: 5 min)
# JOIN_STEP_TIMEOUT=60        # Seconds to wait for the pre-join screen (default: 1 min)
# MAX_CALL_DURATION=21600     # Stop recording after this many seconds (default: 6 h)
# LOST_CALL_TIMEOUT=300       # Stop recording if the call UI is gone this long (default: 5 min)
